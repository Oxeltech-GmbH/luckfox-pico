prefix=/home/basit/arm_build/usr/local
exec_prefix=/home/basit/arm_build/usr/local
libdir=/home/basit/arm_build/usr/local/lib
includedir=${prefix}/include/freerdp2/
libs=-lfreerdp-client2

Name: FreeRDP client
Description: FreeRDP: A Remote Desktop Protocol Implementation
URL: http://www.freerdp.com/
Version: 2.11.2
Requires: 
Requires.private: winpr2 freerdp2
Libs: -L${libdir} ${libs}
Libs.private: -ldl -lpthread
Cflags: -I${includedir}
