prefix=/home/basit/arm_build/usr/local
exec_prefix=/home/basit/arm_build/usr/local
libdir=/home/basit/arm_build/usr/local/lib
includedir=${prefix}/include/winpr2
libs=-lwinpr2

Name: WinPR
Description: WinPR: Windows Portable Runtime
URL: http://www.freerdp.com/
Version: 2.11.2
Requires:
Requires.private: libssl
Libs: -L${libdir} ${libs}
Libs.private: -ldl -lrt -lm -lpthread
Cflags: -I${includedir}
